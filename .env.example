# Base URL for the live MagickVoice application, without a trailing slash.
VITE_MAGICKVOICE_APP_URL=

# Public base URL of THIS documentation site, without a trailing slash. Used at build time
# by scripts/prerender.ts for canonical URLs, sitemap.xml, and the llms.txt exports.
# Defaults to https://magickvoice-user-docs.vercel.app when unset.
SITE_URL=
